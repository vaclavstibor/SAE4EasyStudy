APP_SECRET_KEY=change-me
# SQLite path must be on a persistent volume in Railway (DATA_ROOT=/data).
DATABASE_URL=sqlite:////data/instance/db.sqlite
SESSION_COOKIE_NAME=study-framework
PORT=5000
GUNICORN_WORKERS=1
GUNICORN_LOG_LEVEL=info

# Author shown to participants and researchers.
STUDY_AUTHOR_NAME=Václav Stibor
STUDY_AUTHOR_CONTACT=vaclav.stibor@student.cuni.cz

# ---------------------------------------------------------------------------
# Persistent volume root (Railway).
# Set to /data and mount a Railway Volume at /data. The entrypoint will
# symlink instance/, cache/, plugins/steering/models/, plugins/steering/data/,
# and static/datasets/ under this root so all state survives redeploys.
# Leave empty for local Docker runs (volumes are managed by compose instead).
# ---------------------------------------------------------------------------
DATA_ROOT=/data

# ---------------------------------------------------------------------------
# First-boot asset bootstrap from GitHub Releases.
# Set both *_BOOTSTRAP vars to 1 on first deploy; they skip re-download if
# files are already present on the volume (fast redeploys after the first).
# ---------------------------------------------------------------------------
DATASET_BOOTSTRAP=1
DATASET_GITHUB_REPO=vaclavstibor/SAE4EasyStudy
DATASET_RELEASE_TAG=v2.0
ML_LATEST_DATASET_ASSET=ml-32m-filtered.zip

SAE_BOOTSTRAP_MODEL=1
SAE_MODEL_GITHUB_REPO=vaclavstibor/SAE4EasyStudy
SAE_MODEL_RELEASE_TAG=v2.0
